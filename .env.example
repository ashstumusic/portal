# Required: the server will not start without this (16+ characters).
# Generate with: openssl rand -hex 32
ADMIN_KEY=

# Optional
PORT=3000
# Where the SQLite database lives (default: ./data.db)
DB_PATH=
# Set to 1 when running behind one reverse proxy (nginx, Render, Fly...)
# so rate limits see visitors' real IP addresses.
TRUST_PROXY=
